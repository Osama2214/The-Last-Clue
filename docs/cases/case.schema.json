{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The Last Clue Case Variant",
  "type": "object",
  "additionalProperties": false,
  "required": ["language", "playerCount", "briefing", "characters", "criminalKey", "scripts", "timeline", "solution", "clues"],
  "properties": {
    "language": { "enum": ["en", "ar"] },
    "playerCount": { "type": "integer", "minimum": 4, "maximum": 8 },
    "briefing": { "$ref": "#/$defs/text" },
    "characters": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/character" }
    },
    "criminalKey": { "$ref": "#/$defs/key" },
    "scripts": {
      "type": "object",
      "minProperties": 3,
      "maxProperties": 6,
      "propertyNames": { "$ref": "#/$defs/key" },
      "additionalProperties": { "$ref": "#/$defs/text" }
    },
    "timeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["time", "event"],
        "properties": {
          "time": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" },
          "event": { "$ref": "#/$defs/text" }
        }
      }
    },
    "solution": { "$ref": "#/$defs/text" },
    "clues": {
      "type": "array",
      "items": { "$ref": "#/$defs/clue" },
      "allOf": [
        { "contains": { "properties": { "round": { "const": 1 } }, "required": ["round"] } },
        { "contains": { "properties": { "round": { "const": 2 } }, "required": ["round"] } },
        { "contains": { "properties": { "round": { "const": 3 } }, "required": ["round"] } }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "playerCount": { "const": 4 } } },
      "then": { "properties": {
        "characters": { "minItems": 3, "maxItems": 3 },
        "scripts": { "minProperties": 3, "maxProperties": 3 }
      } }
    },
    {
      "if": { "properties": { "playerCount": { "enum": [5, 6] } } },
      "then": { "properties": {
        "characters": { "minItems": 4, "maxItems": 4 },
        "scripts": { "minProperties": 4, "maxProperties": 4 }
      } }
    },
    {
      "if": { "properties": { "playerCount": { "const": 7 } } },
      "then": { "properties": {
        "characters": { "minItems": 5, "maxItems": 5 },
        "scripts": { "minProperties": 5, "maxProperties": 5 }
      } }
    },
    {
      "if": { "properties": { "playerCount": { "const": 8 } } },
      "then": { "properties": {
        "characters": { "minItems": 6, "maxItems": 6 },
        "scripts": { "minProperties": 6, "maxProperties": 6 }
      } }
    }
  ],
  "$defs": {
    "key": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[a-z][a-z0-9_-]*$" },
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "roleDescription"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "name": { "$ref": "#/$defs/text" },
        "roleDescription": { "$ref": "#/$defs/text" }
      }
    },
    "clue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "round", "audience", "body"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "round": { "type": "integer", "minimum": 1, "maximum": 3 },
        "audience": { "enum": ["Public", "Detectives", "Character"] },
        "characterKey": { "$ref": "#/$defs/key" },
        "body": { "$ref": "#/$defs/text", "maxLength": 2000 }
      },
      "if": { "properties": { "audience": { "const": "Character" } }, "required": ["audience"] },
      "then": { "required": ["characterKey"] },
      "else": { "not": { "required": ["characterKey"] } }
    }
  }
}
