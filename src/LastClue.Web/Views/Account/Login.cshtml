@{ ViewData["Title"] = "Sign in"; }
<section class="account-panel">
    <h1>Sign in</h1>
    <form data-auth-form="login" method="post">
        <p class="field-error" role="alert" data-form-error hidden></p>
        <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <input id="email" name="email" type="email" autocomplete="username" maxlength="256" required class="form-control" aria-describedby="email-error" />
            <span id="email-error" class="field-error" data-field-error="email"></span>
        </div>
        <div class="mb-3">
            <label for="password" class="form-label">Password</label>
            <input id="password" name="password" type="password" autocomplete="current-password" maxlength="128" required class="form-control" aria-describedby="password-error" />
            <span id="password-error" class="field-error" data-field-error="password"></span>
        </div>
        <button class="btn btn-primary" type="submit">Sign in</button>
    </form>
    <p class="mt-3"><a asp-action="Register">Create an account</a></p>
</section>
